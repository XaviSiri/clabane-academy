// Clabane Academy — relational schema.
//
// Principle enforced throughout: this database stores METADATA ONLY for
// videos and documents. The binary files themselves live in object storage
// (see src/lib/storage). Never add a bytes/blob column for file content here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EMPLOYEE
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  DEACTIVATED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String? // null until account is activated
  role         Role
  status       AccountStatus @default(PENDING_ACTIVATION)

  // Activation / password-reset (single-use, expiring tokens)
  activationTokenHash String?   @unique
  activationExpiresAt DateTime?
  resetTokenHash      String?   @unique
  resetExpiresAt      DateTime?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile EmployeeProfile?

  uploadedVideos     Video[]             @relation("VideoUploadedBy")
  uploadedDocuments  Document[]          @relation("DocumentUploadedBy")
  createdModules     Module[]            @relation("ModuleCreatedBy")
  auditLogs          AuditLog[]
  assessmentAttempts AssessmentAttempt[]
  lessonProgress     LessonProgress[]
  videoProgress      VideoProgress[]
  moduleProgress     ModuleProgress[]
  certificates       Certificate[]

  @@index([role, status])
}

model EmployeeProfile {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @unique
  fullName   String
  department String?
  jobTitle   String?
  startDate  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Content: Modules -> Lessons -> (Video | Document | Text) -> Assessment
// ---------------------------------------------------------------------------

model Module {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  order       Int     @default(0)
  isPublished Boolean @default(false)
  isRequired  Boolean @default(true)

  createdBy   User   @relation("ModuleCreatedBy", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons        Lesson[]
  assessment     Assessment?
  moduleProgress ModuleProgress[]

  @@index([order])
}

model Lesson {
  id          String  @id @default(cuid())
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId    String
  title       String
  slug        String
  order       Int     @default(0)
  isPublished Boolean @default(false)

  // Rich text / key learning points body (Markdown). Placeholders such as
  // [INSERT CLABANE COMPANY HISTORY] belong here until admins fill them in.
  content String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos         Video[]
  documents      Document[]
  lessonProgress LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, order])
}

// ---------------------------------------------------------------------------
// Video metadata (files live in object storage — see StorageService)
// ---------------------------------------------------------------------------

model Video {
  id       String @id @default(cuid())
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String

  title       String
  description String?

  storageProvider String // e.g. "s3" | "r2" | "local"
  storageBucket   String
  storageKey      String // object key within the bucket, never a public URL
  thumbnailKey    String?

  durationSeconds Int?
  fileSizeBytes   BigInt?
  mimeType        String?

  // Percentage (0-100) of playback required to mark a video "completed".
  // Configurable per-video; defaults to the platform default (90%).
  completionThresholdPercent Int @default(90)

  isPublished Boolean @default(false)

  uploadedBy   User   @relation("VideoUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress VideoProgress[]

  @@index([lessonId])
}

model Document {
  id       String @id @default(cuid())
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String

  title       String
  description String?

  storageProvider String
  storageBucket   String
  storageKey      String

  fileSizeBytes BigInt?
  mimeType      String?

  isPublished Boolean @default(false)

  uploadedBy   User   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model Assessment {
  id       String @id @default(cuid())
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String @unique

  title             String
  passMarkPercent   Int     @default(80)
  allowAnswerReview Boolean @default(false)
  isPublished       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  attempts  AssessmentAttempt[]
}

model Question {
  id           String       @id @default(cuid())
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  type         QuestionType
  text         String
  explanation  String?
  marks        Int          @default(1)
  order        Int          @default(0)
  isActive     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options AnswerOption[]
  answers AttemptAnswer[]

  @@index([assessmentId, order])
}

model AnswerOption {
  id         String   @id @default(cuid())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  attemptAnswers AttemptAnswer[]

  @@index([questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  employee     User       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String

  attemptNumber    Int
  status           AttemptStatus @default(IN_PROGRESS)
  scorePercent     Float?
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  timeTakenSeconds Int?

  answers AttemptAnswer[]

  @@unique([assessmentId, employeeId, attemptNumber])
  @@index([employeeId])
  @@index([assessmentId, employeeId])
}

model AttemptAnswer {
  id               String            @id @default(cuid())
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId        String
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId       String
  selectedOption   AnswerOption?     @relation(fields: [selectedOptionId], references: [id])
  selectedOptionId String?
  isCorrect        Boolean

  @@index([attemptId])
}

// ---------------------------------------------------------------------------
// Progress tracking
// ---------------------------------------------------------------------------

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

model ModuleProgress {
  id          String         @id @default(cuid())
  employee    User           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId    String
  status      ProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([employeeId, moduleId])
  @@index([employeeId])
}

model LessonProgress {
  id          String         @id @default(cuid())
  employee    User           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([employeeId, lessonId])
  @@index([employeeId])
}

model VideoProgress {
  id                  String    @id @default(cuid())
  employee            User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId          String
  video               Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId             String
  lastPositionSeconds Int       @default(0)
  watchedPercent      Int       @default(0)
  isCompleted         Boolean   @default(false)
  lastWatchedAt       DateTime  @default(now())
  completedAt         DateTime?

  @@unique([employeeId, videoId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Certification
// ---------------------------------------------------------------------------

model Certificate {
  id            String   @id @default(cuid())
  certificateNo String   @unique // human-readable unique ID, e.g. CLA-2026-000123
  employee      User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId    String
  issuedAt      DateTime @default(now())

  storageProvider String?
  storageBucket   String?
  storageKey      String? // rendered PDF, cached in object storage

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([createdAt])
}
