# Copy this file to .env.local for development, or configure these as real
# secrets in your hosting provider for staging/production. Never commit an
# actual .env file with real values.

# --- Application ---
APPLICATION_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database ---
# Local dev matches docker-compose.yml. In production, point this at your
# managed Postgres instance.
DATABASE_URL="postgresql://clabane:clabane_dev_password@localhost:5432/clabane_academy"

# --- Authentication ---
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# --- Object storage ---
# STORAGE_PROVIDER: "local" | "minio" | "r2" | "s3"
#   local  - disk-backed, zero dependencies, dev-only fallback
#   minio  - S3-compatible, run via docker-compose for local dev
#   r2     - Cloudflare R2 (recommended production default — see ARCHITECTURE.md)
#   s3     - Amazon S3
STORAGE_PROVIDER="minio"
STORAGE_BUCKET="clabane-academy"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
# Required for "minio" and "r2" (S3-compatible endpoint URL). Omit for "s3".
STORAGE_ENDPOINT="http://localhost:9000"

# Default video-completion threshold (%) used when a video doesn't override it.
DEFAULT_VIDEO_COMPLETION_THRESHOLD="90"

# Default onboarding assessment pass mark (%).
DEFAULT_ASSESSMENT_PASS_MARK="80"
